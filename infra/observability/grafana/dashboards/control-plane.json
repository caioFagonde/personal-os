{
  "title": "Personal OS Control Plane",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Gateway Requests",
      "gridPos": {"x":0,"y":0,"w":8,"h":4},
      "targets": [{"expr":"sum(personal_os_requests_total)","refId":"A"}]
    },
    {
      "type": "stat",
      "title": "Gateway Errors",
      "gridPos": {"x":8,"y":0,"w":8,"h":4},
      "targets": [{"expr":"sum(personal_os_errors_total)","refId":"A"}]
    },
    {
      "type": "timeseries",
      "title": "Request Duration ms",
      "gridPos": {"x":0,"y":4,"w":16,"h":8},
      "targets": [{"expr":"personal_os_request_duration_ms","refId":"A"}]
    }
  ]
}
