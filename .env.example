# Personal OS local development configuration.
# Copy to .env. Do not commit .env or real credentials.

COMPOSE_PROJECT_NAME=personal_os
ENVIRONMENT=local
TZ=America/Sao_Paulo

# Core database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=personal_os
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=<generate-a-local-password>
DATABASE_URL=postgresql://personal_os:<generate-a-local-password>@postgres:5432/personal_os

# NATS
NATS_URL=nats://nats:4222

# MinIO
MINIO_ROOT_USER=<generate-minio-user>
MINIO_ROOT_PASSWORD=<generate-minio-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET=artifacts
STORAGE_BACKEND=local

# Service ports
API_GATEWAY_PORT=8080
SYNC_ENGINE_PORT=8081
COMMAND_BUS_PORT=8082
MODULE_SERVICE_PORT=8083
RESEARCH_SERVICE_PORT=8084
AUTOMATION_SERVICE_PORT=8085
DIGITAL_TWIN_SERVICE_PORT=8086
WEB_PORT=9000

# Auth and signing
AUTH_REQUIRED=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_KID=local-v1
ACTIVE_JWT_KID=local-v1
# Optional JSON object for key rotation, e.g. {"local-v1":"...","local-v2":"..."}
JWT_KEY_RING=
JWT_ISSUER=personal-os-local
JWT_AUDIENCE=personal-os
JWT_SECRET=<generate-with-openssl-rand-hex-32>
DEVICE_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
COMMAND_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
N8N_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
TOKEN_ENCRYPTION_KEY=<generate-32-byte-base64-key>

# Cloud integrations — placeholders only. Use OAuth flows, not pasted refresh tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/cloud/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/cloud/microsoft/callback

# Optional local AI
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333

# Research acquisition and ingestion
RESEARCH_CACHE_DIR=/data/research/pdf-cache
RESEARCH_FETCH_MAX_BYTES=52428800
# The system supports lawful/open/user-authorized sources only. Do not remove these blocks.
FORBIDDEN_SOURCE_HOST_PATTERNS=libgen,library genesis,z-library,zlibrary,z-lib,sci-hub,annas-archive,annasarchive

# Optional private mesh
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=personal-os-dev
TAILSCALE_STATE_DIR=/var/lib/tailscale

# Optional notifications
NTFY_BASE_URL=http://ntfy:80
NTFY_TOPIC=personal-os-dev

# Frontend
VITE_API_URL=http://localhost:8080
VITE_SYNC_URL=http://localhost:8080/api/proxy/sync
VITE_COMMAND_BUS_URL=http://localhost:8080/api/proxy/commands
VITE_MODULE_API_URL=http://localhost:8080/api/proxy/modules
VITE_RESEARCH_URL=http://localhost:8080/api/proxy/research
VITE_AUTOMATION_URL=http://localhost:8080/api/proxy/automation
VITE_DIGITAL_TWIN_URL=http://localhost:8080/api/proxy/digital-twin
VITE_REQUIRE_APPROVALS=true

# Build metadata
VITE_APP_VERSION=0.7.0
VITE_BUILD_CHANNEL=dev
ANDROID_PACKAGE_ID=io.personalos.mobile
DESKTOP_BUNDLE_ID=io.personalos.desktop

# Phase 7 production/observability/release
SERVICE_TOKEN_SECRET=replace-with-generated-service-token-secret
SERVICE_TOKEN_ISSUER=personal-os-control-plane
SERVICE_TOKEN_AUDIENCE=personal-os-internal
SERVICE_TOKEN_TTL_SECONDS=300
APP_VERSION=0.7.0
RELEASE_CHANNEL=dev
GIT_COMMIT_SHA=0000000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
