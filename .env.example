# Personal OS / Nexus Prime — environment template
# Copy to .env, then run: python3 scripts/generate-env.py .env
# Placeholders in <angle-brackets> are replaced with locally generated secrets.
# NEVER commit .env. NEVER put real personal addresses or phone numbers here in the template.

# --- core stack ---
COMPOSE_PROJECT_NAME=personal-os
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=<generate-a-local-password>
POSTGRES_DB=personal_os
POSTGRES_PORT=5432
DATABASE_URL=<generate-a-local-password>
NATS_URL=nats://nats:4222

# --- object storage ---
MINIO_ROOT_USER=<generate-minio-user>
MINIO_ROOT_PASSWORD=<generate-minio-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=personal-os
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BACKEND=minio

# --- service ports ---
API_GATEWAY_PORT=8080
SYNC_ENGINE_PORT=8081
COMMAND_BUS_PORT=8082
MODULE_SERVICE_PORT=8083
RESEARCH_SERVICE_PORT=8084
AUTOMATION_SERVICE_PORT=8085
DIGITAL_TWIN_SERVICE_PORT=8086
CAPTURE_SERVICE_PORT=8087
STUDY_COMPANION_SERVICE_PORT=8088
CONNECTOR_SERVICE_PORT=8094
MODEL_RUNTIME_SERVICE_PORT=8095
CODING_AGENT_SERVICE_PORT=8096
WEB_PORT=9000

# --- auth & signing ---
AUTH_REQUIRED=false
REQUIRE_DEVICE_PAIRING=true
JWT_SECRET=<generate-with-openssl-rand-hex-32>
DEVICE_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
COMMAND_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
SERVICE_TOKEN_SECRET=<generate-with-openssl-rand-hex-32>
TOKEN_ENCRYPTION_KEY=<generate-32-byte-base64-key>
TOKEN_ENCRYPTION_KEY_VERSION=1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS (comma-separated origins; * only for local development) ---
CORS_ALLOW_ORIGINS=*

# --- web client URLs (gateway-proxied by default) ---
VITE_API_URL=http://localhost:8080
VITE_SYNC_URL=http://localhost:8080/api/proxy/sync
VITE_COMMAND_BUS_URL=http://localhost:8080/api/proxy/commands
VITE_MODULE_API_URL=http://localhost:8080/api/proxy/modules
VITE_RESEARCH_URL=http://localhost:8080/api/proxy/research
VITE_AUTOMATION_URL=http://localhost:8080/api/proxy/automation
VITE_DIGITAL_TWIN_URL=http://localhost:8080/api/proxy/digital-twin
VITE_CAPTURE_URL=http://localhost:8080/api/proxy/capture
VITE_STUDY_COMPANION_URL=http://localhost:8080/api/proxy/study-companion
VITE_CONNECTORS_URL=http://localhost:8080/api/proxy/connectors
VITE_MODEL_RUNTIME_URL=http://localhost:8080/api/proxy/model-runtime
VITE_CODING_AGENT_URL=http://localhost:8080/api/proxy/coding-agent

# --- automation / n8n ---
N8N_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
OUTBOX_DRAIN_LIMIT=25

# --- research / intelligence source policy ---
SEARXNG_SECRET=<generate-with-openssl-rand-hex-32>
RESEARCH_FETCH_MAX_BYTES=26214400
FORBIDDEN_SOURCE_HOST_PATTERNS="*.internal *.local localhost 127.* 10.* 172.16.* 192.168.*"

# --- connectors: OAuth (leave empty until you create your own OAuth apps) ---
CONNECTOR_PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/proxy/connectors/api/connectors/google/callback
GMAIL_API_BASE_URL=https://gmail.googleapis.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/proxy/connectors/api/connectors/microsoft/callback

# --- connectors: messaging (all optional; delegation fails closed until set) ---
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
SECRETARY_EMAIL=
SECRETARY_WHATSAPP=
SEND_CONNECTOR_TESTS=false

# --- connectors: notifications & network ---
NTFY_BASE_URL=http://ntfy:80
NTFY_TOPIC=personal-os
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=personal-os
TAILSCALE_STATE_DIR=./data/tailscale

# --- connectors: Obsidian vault (absolute path on the host running connector-service) ---
OBSIDIAN_VAULT_PATH=

# --- connector worker ---
CONNECTOR_WORKER_ENABLED=false
CONNECTOR_WORKER_EXECUTE=false
CONNECTOR_WORKER_INTERVAL_SECONDS=300

# --- backups ---
REMOTE_BACKUP_PROVIDER=

# --- model runtime (honest degradation: heuristic/demo until providers configured) ---
OCR_PROVIDER=heuristic
VISION_PROVIDER=heuristic
AUDIO_PROVIDER=disabled
MODEL_RUNTIME_MAX_BYTES=26214400
ANALOG_CAPTURE_MAX_BYTES=26214400

# --- coding agent (dry-run by default; execution requires explicit opt-in) ---
CODING_AGENT_EXECUTE=false
CODING_AGENT_REPO_PATH=./
CODING_AGENT_ALLOWED_REPO_ROOTS=./
CODING_AGENT_WORKTREE_ROOT=./workspace/agent-worktrees
CLAUDE_CODE_COMMAND=claude
