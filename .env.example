# Personal OS local development configuration.
# Copy to .env. Do not commit .env or real credentials.

COMPOSE_PROJECT_NAME=personal_os
ENVIRONMENT=local
TZ=America/Sao_Paulo

# Core database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=personal_os
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=<generate-a-local-password>
DATABASE_URL=postgresql://personal_os:<generate-a-local-password>@postgres:5432/personal_os

# NATS
NATS_URL=nats://nats:4222

# MinIO
MINIO_ROOT_USER=<generate-minio-user>
MINIO_ROOT_PASSWORD=<generate-minio-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET=artifacts
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
STORAGE_BACKEND=local

# Service ports
API_GATEWAY_PORT=8080
SYNC_ENGINE_PORT=8081
COMMAND_BUS_PORT=8082
MODULE_SERVICE_PORT=8083
RESEARCH_SERVICE_PORT=8084
AUTOMATION_SERVICE_PORT=8085
DIGITAL_TWIN_SERVICE_PORT=8086
CAPTURE_SERVICE_PORT=8092
STUDY_COMPANION_SERVICE_PORT=8093
CONNECTOR_SERVICE_PORT=8094
WEB_PORT=9000

# Auth and signing
AUTH_REQUIRED=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_KID=local-v1
ACTIVE_JWT_KID=local-v1
# Optional JSON object for key rotation, e.g. {"local-v1":"...","local-v2":"..."}
JWT_KEY_RING=
JWT_ISSUER=personal-os-local
JWT_AUDIENCE=personal-os
JWT_SECRET=<generate-with-openssl-rand-hex-32>
DEVICE_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
COMMAND_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
N8N_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
SEARXNG_SECRET=<generate-with-openssl-rand-hex-32>
TOKEN_ENCRYPTION_KEY=<generate-32-byte-base64-key>

# Cloud integrations — placeholders only. Use OAuth flows, not pasted refresh tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/proxy/connectors/api/connectors/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/proxy/connectors/api/connectors/microsoft/callback

# Optional local AI
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333

# Research acquisition and ingestion
RESEARCH_CACHE_DIR=/data/research/pdf-cache
RESEARCH_FETCH_MAX_BYTES=52428800
# The system supports lawful/open/user-authorized sources only. Do not remove these blocks.
FORBIDDEN_SOURCE_HOST_PATTERNS="libgen,library genesis,z-library,zlibrary,z-lib,sci-hub,annas-archive,annasarchive"

# Optional private mesh
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=personal-os-dev
TAILSCALE_STATE_DIR=/var/lib/tailscale

# Optional notifications
NTFY_BASE_URL=http://ntfy:80
NTFY_TOPIC=personal-os-dev

# Frontend
VITE_API_URL=http://localhost:8080
VITE_SYNC_URL=http://localhost:8080/api/proxy/sync
VITE_COMMAND_BUS_URL=http://localhost:8080/api/proxy/commands
VITE_MODULE_API_URL=http://localhost:8080/api/proxy/modules
VITE_RESEARCH_URL=http://localhost:8080/api/proxy/research
VITE_AUTOMATION_URL=http://localhost:8080/api/proxy/automation
VITE_DIGITAL_TWIN_URL=http://localhost:8080/api/proxy/digital-twin
VITE_CAPTURE_URL=http://localhost:8080/api/proxy/capture
VITE_STUDY_COMPANION_URL=http://localhost:8080/api/proxy/study-companion
VITE_CONNECTORS_URL=http://localhost:8080/api/proxy/connectors
VITE_REQUIRE_APPROVALS=true

# Build metadata
VITE_APP_VERSION=0.7.0
VITE_BUILD_CHANNEL=dev
ANDROID_PACKAGE_ID=io.personalos.mobile
DESKTOP_BUNDLE_ID=io.personalos.desktop

# Phase 7 production/observability/release
SERVICE_TOKEN_SECRET=replace-with-generated-service-token-secret
SERVICE_TOKEN_ISSUER=personal-os-control-plane
SERVICE_TOKEN_AUDIENCE=personal-os-internal
SERVICE_TOKEN_TTL_SECONDS=300
APP_VERSION=0.7.0
RELEASE_CHANNEL=dev
GIT_COMMIT_SHA=0000000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Phase 9 capture, delegation, and study companion
SECRETARY_EMAIL=
SECRETARY_WHATSAPP=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_TEMPLATE=personal_os_task_delegation
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
GMAIL_API_BASE_URL=https://gmail.googleapis.com
ANALOG_CAPTURE_MAX_BYTES=52428800
VISION_PROVIDER=heuristic
OCR_PROVIDER=heuristic

# Optional Twilio WhatsApp provider. Keep real values in .env/.env.local only.
# Trial/sandbox mode requires every recipient to join your Twilio WhatsApp Sandbox first.
WHATSAPP_PROVIDER=cloud_api
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Phase 10 connector onboarding and continuity
CONNECTOR_PUBLIC_BASE_URL=http://localhost:8080
CONNECTOR_INTERNAL_BASE_URL=http://connector-service:8094
BACKUP_DIR=/workspace/backups
SEND_CONNECTOR_TESTS=false
OUTBOX_DRAIN_LIMIT=25
TOKEN_ENCRYPTION_KEY_VERSION=local-v1

# Phase 11 durable connector worker and remote backup dispatch
CONNECTOR_WORKER_ENABLED=true
CONNECTOR_WORKER_EXECUTE=false
CONNECTOR_WORKER_INTERVAL_SECONDS=20
REMOTE_BACKUP_PROVIDER=google
BOOTSTRAP_AUTOMATION_INTERACTIVE=true
BOOTSTRAP_WAIT_FOR_AUTH_SECONDS=600
MOBILE_AUTO_DEPLOY=false
MOBILE_API_URL_MODE=tailscale

# Phase 12 certification and release signing. Keep real values in GitHub Actions secrets or .env.local only.
E2E_BASE_URL=http://127.0.0.1:9000
ADB_WAIT_SECONDS=300
RUN_LIVE_CONNECTOR_TESTS=false
TWILIO_LIVE_SEND=false
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_BUILD_TOOLS_VERSION=35.0.0
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
BOOTSTRAP_WAIT_FOR_OAUTH=true

# Phase 13 live-stack and model runtime certification
MODEL_RUNTIME_SERVICE_PORT=8095
VITE_MODEL_RUNTIME_URL=http://localhost:8080/api/proxy/model-runtime
MODEL_RUNTIME_MAX_BYTES=52428800
AUDIO_PROVIDER=heuristic
MODEL_RUNTIME_REQUIRED=false
LIVE_STACK_E2E_BASE_URL=http://127.0.0.1:9000
RELEASE_READINESS_REQUIRED_PHASES=core,connectors,automation,research,digital-twin,capture,study-companion,model-runtime
GITHUB_RELEASE_REPO=
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_TAG=
PUBLISH_RELEASE_DRY_RUN=true

# Phase 14: Coding Agent / Claude Code
CODING_AGENT_SERVICE_PORT=8096
CODING_AGENT_REPO_PATH=/workspace
CODING_AGENT_ALLOWED_REPO_ROOTS=/workspace
CODING_AGENT_WORKTREE_ROOT=/workspace/.agent-worktrees
CODING_AGENT_EXECUTE=false
CLAUDE_CODE_COMMAND=claude
VITE_CODING_AGENT_URL=http://localhost:8080/api/proxy/coding-agent
