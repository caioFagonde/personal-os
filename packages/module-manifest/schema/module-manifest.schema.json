{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-os.local/schemas/module-manifest.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "routes",
    "permissions",
    "events",
    "storage",
    "sync"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "routes": {
      "type": "object",
      "properties": {
        "web": {
          "type": "string"
        },
        "api": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "publishes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subscribes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string"
        }
      }
    }
  }
}